rules_version = '2';

service cloud.firestore {

  match /databases/{database}/documents {

    function isAdmin() {

      return request.auth != null && exists(/databases/$(database)/documents/admins/$(request.auth.uid));

    }



    function isOwner(userId) {

      return request.auth != null && request.auth.uid == userId;

    }

    function agentFor(userId) {

      return request.auth != null &&

        exists(/databases/$(database)/documents/agentSessions/$(request.auth.uid)) &&

        get(/databases/$(database)/documents/agentSessions/$(request.auth.uid)).data.ownerUid == userId;

    }

    function validAgentTokenFor(userId) {

      return request.resource.data.agentToken != null &&

        exists(/databases/$(database)/documents/agentTokens/$(request.resource.data.agentToken)) &&

        get(/databases/$(database)/documents/agentTokens/$(request.resource.data.agentToken)).data.ownerUid == userId;

    }



    function ownerOnlySubscriptionFieldsChanged() {
      // Champs réservés admin / serveur — le propriétaire NE PEUT PAS les modifier.
      // OK pour le propriétaire : managerPinHash, disbursementStatus (demande pending),
      // airtelMoneyNumber, nom, logo, etc.
      return request.resource.data.diff(resource.data).affectedKeys().hasAny([
        'plan', 'subscriptionEndsAt', 'lastPaymentAt', 'trialEndsAt', 'subscriptionType',
        'eventsCount', 'extraEventsBilled', 'eventsResetAt',
        'assignedTabletImei', 'assignedTabletLabel',
        'disbursementId'
      ]);
    }


    function validBarOrderCreate() {

      return request.resource.data.keys().hasAll(['total', 'status', 'createdAt']) &&

        request.resource.data.status == 'pending' &&

        request.resource.data.total is number &&

        request.resource.data.total >= 0 &&

        request.resource.data.total <= 50000000 &&

        request.resource.data.createdAt is int;

    }

    function validQrOrderCreate() {

      return request.resource.data.keys().hasAll(['total', 'status', 'createdAt', 'source']) &&

        request.resource.data.source == 'qr' &&

        (request.resource.data.status == 'awaiting-validation' || request.resource.data.status == 'pending') &&

        request.resource.data.total is number &&

        request.resource.data.total >= 0 &&

        request.resource.data.total <= 50000000 &&

        request.resource.data.createdAt is int;

    }

    // Machine d'état du circuit des commandes :
    // Client → Serveur (awaiting-validation) → Cuisine (validated/in-preparation/ready) → Serveur (delivered) → Gérant (paid/closed)
    function orderStatusTransitionAllowed() {
      // Statut inchangé : modification d'autres champs (attribution, horodatage, paiement)
      return resource.data.status == request.resource.data.status ||
        // Compatibilité anciens statuts
        (resource.data.status == 'pending' && (request.resource.data.status == 'awaiting-validation' || request.resource.data.status == 'validated' || request.resource.data.status == 'cancelled')) ||
        (resource.data.status == 'sent' && (request.resource.data.status == 'validated' || request.resource.data.status == 'in-preparation' || request.resource.data.status == 'ready' || request.resource.data.status == 'cancelled')) ||
        (resource.data.status == 'served' && (request.resource.data.status == 'delivered' || request.resource.data.status == 'paid' || request.resource.data.status == 'closed')) ||
        (resource.data.status == 'completed' && (request.resource.data.status == 'delivered' || request.resource.data.status == 'paid' || request.resource.data.status == 'closed')) ||
        // Nouvelle machine d'état
        (resource.data.status == 'awaiting-validation' && (request.resource.data.status == 'validated' || request.resource.data.status == 'cancelled')) ||
        (resource.data.status == 'validated' && (request.resource.data.status == 'in-preparation' || request.resource.data.status == 'ready' || request.resource.data.status == 'cancelled')) ||
        (resource.data.status == 'in-preparation' && (request.resource.data.status == 'ready' || request.resource.data.status == 'validated' || request.resource.data.status == 'cancelled')) ||
        (resource.data.status == 'ready' && request.resource.data.status == 'delivered') ||
        (resource.data.status == 'delivered' && request.resource.data.status == 'paid') ||
        (resource.data.status == 'paid' && request.resource.data.status == 'closed');
    }



    function validPaymentCreate() {

      return request.resource.data.status == 'pending' &&

        request.resource.data.amount is number &&

        request.resource.data.amount >= 100 &&

        request.resource.data.amount <= 50000000;

    }



    // --- Profil public (menu QR, carte) — sans données sensibles ---

    match /publicProfiles/{userId} {

      allow read: if true;

      allow write: if isOwner(userId) || isAdmin();

    }



    // Sessions agents (authentification anonyme + lien vers le propriétaire)
    // Permet aux agents de lire/écrire les commandes sans exposition publique.
    // La création exige un agentToken valide mappé au propriétaire.
    match /agentSessions/{uid} {
      allow read: if request.auth != null && request.auth.uid == uid;
      allow create, update: if request.auth != null &&
        request.auth.uid == uid &&
        request.resource.data.ownerUid is string &&
        request.resource.data.agentCode is string &&
        exists(/databases/$(database)/documents/agentTokens/$(request.resource.data.agentCode)) &&
        get(/databases/$(database)/documents/agentTokens/$(request.resource.data.agentCode)).data.ownerUid == request.resource.data.ownerUid;
      allow delete: if false;
    }

    match /agentTokens/{id} {

      allow read: if true;

      allow create: if request.auth != null &&

        request.resource.data.ownerUid == request.auth.uid;

      allow update, delete: if request.auth != null && (

        resource.data.ownerUid == request.auth.uid || isAdmin()

      );

    }



    match /admins/{uid} {

      allow read: if request.auth != null && request.auth.uid == uid;

      allow write: if false;

    }



    match /profiles/{userId}/events/{eventId} {

      allow read: if true;

      allow write: if isOwner(userId) || isAdmin();

      match /tickets/{ticketId} {

        allow read: if true;

        allow write: if isOwner(userId) || isAdmin();

      }

    }



    match /profiles/{userId}/products/{productId} {

      allow read: if true;

      allow write: if isOwner(userId) || isAdmin();

    }



    match /profiles/{userId}/tables/{tableId} {

      allow read: if true;

      allow write: if isOwner(userId) || isAdmin();

    }



    match /profiles/{userId}/menuDigital/{docId} {

      allow read: if true;

      allow write: if isOwner(userId) || isAdmin();

    }



    // Commandes internes et menu digital : propriétaire, admin ou agent lié par session
    // Création publique autorisée uniquement pour les commandes menu digital (source 'qr')
    match /profiles/{userId}/orders/{orderId} {

      allow read: if isOwner(userId) || isAdmin() || agentFor(userId);

      allow create: if validQrOrderCreate() || (isOwner(userId) || isAdmin()) || validAgentTokenFor(userId) || agentFor(userId);

      allow update: if (isOwner(userId) || isAdmin()) || ((validAgentTokenFor(userId) || agentFor(userId)) && orderStatusTransitionAllowed());

      allow delete: if isOwner(userId) || isAdmin();

    }



    match /profiles/{userId}/barOrders/{orderId} {

      allow read: if isOwner(userId) || isAdmin();

      allow create: if validBarOrderCreate();

      allow update, delete: if isOwner(userId) || isAdmin();

    }



    match /profiles/{userId}/payments/{paymentId} {

      allow read: if isOwner(userId) || isAdmin();

      allow create: if isOwner(userId) && validPaymentCreate();

      allow update: if isAdmin() || (

        isOwner(userId) &&

        resource.data.status == 'pending' &&

        request.resource.data.status == 'pending'

      );

      allow delete: if isAdmin();

    }



    match /profiles/{userId}/orderCancellations/{cancellationId} {

      allow read, write: if isOwner(userId) || isAdmin();

    }



    match /profiles/{userId}/team/{memberId} {

      allow read, write: if isOwner(userId) || isAdmin();

    }



    // Profil privé : propriétaire ou admin uniquement
    match /profiles/{userId} {
      allow read: if isOwner(userId) || isAdmin();
      allow create: if isOwner(userId);
      allow update: if isAdmin() || (isOwner(userId) && !ownerOnlySubscriptionFieldsChanged());
      allow delete: if isAdmin();
    }

    match /profiles/{userId}/notifications/{notificationId} {
      allow read, write: if isOwner(userId) || isAdmin();
    }
    match /profiles/{userId}/sales/{saleId} {
      allow read, write: if isOwner(userId) || isAdmin();
    }
    match /profiles/{userId}/losses/{lossId} {
      allow read, write: if isOwner(userId) || isAdmin();
    }
    match /profiles/{userId}/receipts/{receiptId} {
      allow read, write: if isOwner(userId) || isAdmin();
    }
    match /profiles/{userId}/customers/{customerId} {
      allow read, write: if isOwner(userId) || isAdmin();
    }
    match /profiles/{userId}/config/{docId} {
      allow read, write: if isOwner(userId) || isAdmin();
    }
    match /profiles/{userId}/barConnectee/{docId} {
      allow read, write: if isOwner(userId) || isAdmin();
    }

    match /establishments/{estId} {

      allow read: if true;

      allow create: if request.auth != null &&

        request.resource.data.ownerUid == request.auth.uid;

      allow update, delete: if request.auth != null && (

        resource.data.ownerUid == request.auth.uid || isAdmin()

      );



      match /products/{productId} {

        allow read: if true;

        allow write: if request.auth != null && (

          get(/databases/$(database)/documents/establishments/$(estId)).data.ownerUid == request.auth.uid ||

          isAdmin()

        );

      }

      match /tables/{tableId} {

        allow read: if true;

        allow write: if request.auth != null && (

          get(/databases/$(database)/documents/establishments/$(estId)).data.ownerUid == request.auth.uid ||

          isAdmin()

        );

      }

      match /menuDigital/{docId} {

        allow read: if true;

        allow write: if request.auth != null && (

          get(/databases/$(database)/documents/establishments/$(estId)).data.ownerUid == request.auth.uid ||

          isAdmin()

        );

      }

      match /orders/{orderId} {

        allow read: if request.auth != null && (

          get(/databases/$(database)/documents/establishments/$(estId)).data.ownerUid == request.auth.uid ||

          isAdmin()

        );

        allow create: if request.auth != null && (

          get(/databases/$(database)/documents/establishments/$(estId)).data.ownerUid == request.auth.uid ||

          isAdmin()

        );

        allow update: if request.auth != null && (

          get(/databases/$(database)/documents/establishments/$(estId)).data.ownerUid == request.auth.uid ||

          isAdmin()

        ) && orderStatusTransitionAllowed();

        allow delete: if request.auth != null && (

          get(/databases/$(database)/documents/establishments/$(estId)).data.ownerUid == request.auth.uid ||

          isAdmin()

        );

      }

      match /events/{eventId} {

        allow read: if true;

        allow write: if request.auth != null && (

          get(/databases/$(database)/documents/establishments/$(estId)).data.ownerUid == request.auth.uid ||

          isAdmin()

        );

        match /tickets/{ticketId} {

          allow read: if true;

          allow write: if request.auth != null && (

            get(/databases/$(database)/documents/establishments/$(estId)).data.ownerUid == request.auth.uid ||

            isAdmin()

          );

        }

      }

      match /barOrders/{orderId} {

        allow read: if request.auth != null && (

          get(/databases/$(database)/documents/establishments/$(estId)).data.ownerUid == request.auth.uid ||

          isAdmin()

        );

        allow create: if validBarOrderCreate();

        allow update, delete: if request.auth != null && (

          get(/databases/$(database)/documents/establishments/$(estId)).data.ownerUid == request.auth.uid ||

          isAdmin()

        );

      }

      match /payments/{paymentId} {

        allow read: if request.auth != null && (

          get(/databases/$(database)/documents/establishments/$(estId)).data.ownerUid == request.auth.uid ||

          isAdmin()

        );

        allow create: if request.auth != null &&

          get(/databases/$(database)/documents/establishments/$(estId)).data.ownerUid == request.auth.uid &&

          validPaymentCreate();

        allow update: if isAdmin();

        allow delete: if isAdmin();

      }

      match /{document=**} {

        allow read, write: if request.auth != null && (

          get(/databases/$(database)/documents/establishments/$(estId)).data.ownerUid == request.auth.uid ||

          isAdmin()

        );

      }

    }



    match /subscriptionPlans/{planId} {

      allow read, write: if isAdmin();

    }



    // Affiliés : lecture publique (sans mot de passe), écriture admin

    match /affiliates/{code} {

      allow read: if true;

      allow create, update, delete: if isAdmin();

    }



    // Hash mot de passe affilié — serveur uniquement (Admin SDK)

    match /affiliateAuth/{code} {

      allow read, write: if false;

    }



    match /disbursementRequests/{requestId} {

      allow create: if request.auth != null &&

        request.resource.data.userId == request.auth.uid &&

        request.resource.data.status == 'pending';

      allow read: if request.auth != null &&

        (resource.data.userId == request.auth.uid || isAdmin());

      allow update, delete: if isAdmin();

    }



    match /tablets/{tabletId} {

      allow read: if request.auth != null &&

        (resource.data.ownerUid == request.auth.uid || isAdmin());

      allow create: if request.auth != null && (

        (request.resource.data.ownerUid == request.auth.uid && request.resource.data.assignedByAdmin != true) ||

        (isAdmin() && request.resource.data.assignedByAdmin == true)

      );

      allow update: if request.auth != null &&

        (resource.data.ownerUid == request.auth.uid || isAdmin());

      allow delete: if isAdmin();



      match /messages/{messageId} {

        allow read: if request.auth != null && (

          isAdmin() ||

          get(/databases/$(database)/documents/tablets/$(tabletId)).data.ownerUid == request.auth.uid

        );

        allow create: if isAdmin();

        allow update: if request.auth != null && (

          isAdmin() ||

          (

            get(/databases/$(database)/documents/tablets/$(tabletId)).data.ownerUid == request.auth.uid &&

            request.resource.data.diff(resource.data).affectedKeys().hasOnly(['readAt'])

          )

        );

        allow delete: if isAdmin();

      }

    }



    match /supportTickets/{ticketId} {

      allow create: if request.auth != null &&

        request.resource.data.ownerUid == request.auth.uid;

      allow read: if request.auth != null &&

        (resource.data.ownerUid == request.auth.uid || isAdmin());

      allow update: if isAdmin();

      allow delete: if isAdmin();

    }

  }

}

